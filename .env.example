# Pradhikaran City Digital Twin Environment Configuration

# Core API
PORT=3001
NODE_ENV=development
JWT_SECRET=pradhikaran_digital_twin_super_secret_dev_key_2026
CORS_ORIGIN=http://localhost:5173

# Study Area Reference Center
STUDY_AREA_LAT=18.651674
STUDY_AREA_LON=73.761536
STUDY_AREA_RADIUS_M=1000
STUDY_AREA_MARGIN_M=150

# Database Configuration (PostgreSQL with PostGIS)
# If POSTGIS_ENABLED=false or connection fails, the API gracefully uses the embedded spatial repository
POSTGIS_ENABLED=false
DATABASE_URL=postgres://pradhikaran_user:pradhikaran_pass@localhost:5432/pradhikaran_twin
DB_HOST=localhost
DB_PORT=5432
DB_USER=pradhikaran_user
DB_PASSWORD=pradhikaran_pass
DB_NAME=pradhikaran_twin

# AI Microservice
AI_SERVICE_URL=http://localhost:8000

# Cesium & 3D Visualization
# Cesium ion token is strictly optional; open raster/vector providers are used by default
VITE_CESIUM_ION_TOKEN=
# Optional Google 3D Tiles (disabled by default; core twin runs natively without it)
VITE_GOOGLE_MAPS_API_KEY=
